    <br><br><br><br>

    <section class="hero">
      <div class="hero-card">
        <div class="hero-card-header">
          <span class="dot dot-red"></span>
          <span class="dot dot-yellow"></span>
          <span class="dot dot-green"></span>
        </div>

        <div class="hero-card-body">

          <div class="hero-left">
            <h1 class="hero-title">
              Le premier CV qui tourne<br>dans <span class="accent">un conteneur.</span>
            </h1>
            <p class="hero-desc">
              Pas un PDF statique. Un pod Kubernetes instancié à la demande, servi depuis mon propre serveur avec load balancing entre 3 réplicas.
            </p>
            <button class="button hero-button">
              Démarrer un conteneur
              <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
                <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zm4.28 10.28a.75.75 0 000-1.06l-3-3a.75.75 0 10-1.06 1.06l1.72 1.72H8.25a.75.75 0 000 1.5h5.69l-1.72 1.72a.75.75 0 101.06 1.06l3-3z" clip-rule="evenodd"></path>
              </svg>
            </button>
          </div>

          <div class="hero-right">
            <div class="cube-glow"></div>
            <div class="cube-scene">
              <div class="cube">
                <div class="face front"></div>
                <div class="face back"></div>
                <div class="face left"></div>
                <div class="face right"></div>
                <div class="face top"></div>
                <div class="face bottom"></div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

