<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Enzo Granana — Étudiant en informatique à la recherche d'une alternance NetDevOps / Admin système pour septembre 2026 sur Montpellier.">
  <title>Enzo Granana - Alternance Septembre 2026</title>
  <link rel="icon" type="image/x-icon" href="images/favicon.ico">
