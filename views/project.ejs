<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= project.description %>">
  <title>Enzo Granana - <%= project.title %></title>
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
  <link rel="stylesheet" href="/css/background.css">
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>

  <header>
    <%- include('../static/components/navbar', {}) %>
  </header>

  <main>
    <article class="project-page">
      <div class="project-page-inner">

        <a href="/projects" class="project-page-back">Tous mes projets</a>

        <header class="project-page-header">
          <span class="project-page-type"><%= project.type %></span>
          <h1 class="project-page-title"><%= project.title %></h1>
        </header>

        <section class="project-page-section">
          <h2 class="project-page-section-title">Description</h2>
          <p class="project-page-text"><%= project.description %></p>
        </section>

        <section class="project-page-section">
          <h2 class="project-page-section-title">Technologies</h2>
          <div class="project-techs project-page-techs">
            <% project.technologies.forEach(function (tech) { %>
              <span class="tech-badge"><%= tech %></span>
            <% }) %>
          </div>
        </section>

        <% if ((project.medias && project.medias.length > 0) || (project.images && project.images.length > 0)) { %>
          <section class="project-page-section">
            <h2 class="project-page-section-title">Medias</h2>
            <div class="project-page-medias">
              <% (project.images || []).forEach(function (img) { %>
                <img class="project-page-media" src="<%= img %>" alt="<%= project.title %> — média">
              <% }) %>
              <% (project.medias || []).forEach(function (media) { %>
                <% if (/\.(mp4|webm|ogg)$/i.test(media)) { %>
                  <video class="project-page-media" autoplay loop muted playsinline preload="auto">
                    <source src="<%= media %>">
                  </video>
                <% } else { %>
                  <img class="project-page-media" src="<%= media %>" alt="<%= project.title %> — média">
                <% } %>
              <% }) %>
            </div>
          </section>
        <% } %>

        <section class="project-page-section">
          <h2 class="project-page-section-title">Contexte</h2>
          <p class="project-page-text"><%= project.context %></p>
        </section>

        <section class="project-page-section">
          <h2 class="project-page-section-title">Retour sur expérience</h2>
          <p class="project-page-text"><%= project.rex %></p>
        </section>

        <div class="project-page-cta">
          <a href="<%= project.github %>" target="_blank" class="hero-cta">
            Voir sur GitHub
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd"
                d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zm4.28 10.28a.75.75 0 000-1.06l-3-3a.75.75 0 10-1.06 1.06l1.72 1.72H8.25a.75.75 0 000 1.5h5.69l-1.72 1.72a.75.75 0 101.06 1.06l3-3z"
                clip-rule="evenodd"></path>
            </svg>
          </a>
        </div>

      </div>
    </article>
  </main>

  <%- include('../static/components/footer', {}) %>

  <script src="/scripts/fetch.js"></script>

</body>

</html>
