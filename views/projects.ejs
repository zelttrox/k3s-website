<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Enzo Granana — Tous mes projets personnels et académiques en infra, cloud, devops et développement.">
  <title>Enzo Granana - Projets</title>
  <link rel="icon" type="image/x-icon" href="images/favicon.ico">
  <link rel="stylesheet" href="css/background.css">
  <link rel="stylesheet" href="css/style.css">
</head>

<body>

  <header>
    <%- include('../static/components/navbar', {}) %>
  </header>

  <main>
    <section class="projects-page">
      <div class="projects-page-inner">
        <h1 class="projects-page-title">Mes <span class="accent">projets</span></h1>
        <div class="projects-page-grid">
          <% projects.forEach(function (project) { %>
            <article class="glow-card">
              <a href="/projects/<%= project.slug %>" class="glow-card-link" aria-label="<%= project.title %>"></a>
              <h3 class="project-title"><%= project.title %></h3>
              <p class="project-desc"><%= project.description %></p>
              <div class="project-techs">
                <% project.technologies.forEach(function (tech) { %>
                  <span class="tech-badge"><%= tech %></span>
                <% }) %>
              </div>
              <a href="<%= project.github %>" target="_blank" class="project-link">Voir sur GitHub →</a>
            </article>
          <% }) %>
        </div>
      </div>
    </section>
  </main>

  <%- include('../static/components/footer', {}) %>

  <script src="scripts/fetch.js"></script>
  <script src="scripts/projects-carousel.js" defer></script>

</body>

</html>
