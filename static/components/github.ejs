<section class="github">
    <div class="github-card">
        <div class="github-card-body">
            <div class="github-months" id="github-months"></div>
            <div class="github-body">
                <div class="github-days">
                    <span>Lun</span>
                    <span>Mer</span>
                    <span>Ven</span>
                </div>
                <div class="github-grid" id="github-grid"></div>
            </div>
            <div class="github-footer">
                <span class="github-total" id="github-total">Chargement…</span>
                <div class="github-legend">
                    <span>Moins</span>
                    <span class="github-cell level-0"></span>
                    <span class="github-cell level-1"></span>
                    <span class="github-cell level-2"></span>
                    <span class="github-cell level-3"></span>
                    <span class="github-cell level-4"></span>
                    <span>Plus</span>
                </div>
            </div>
        </div>
    </div>

    <div class="github-tooltip" id="github-tooltip"></div>
</section>

<script src="scripts/github.js" defer></script>
